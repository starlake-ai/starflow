{# A SELECT that reads its target must give the rows it gave before the DELETE. Spark has no
   temporary table, and recomputes a cached one once the DELETE changes the table it reads: the
   rows go to a table of the domain, SL_INCOMING_<table>, dropped at the end. Delta takes no
   subquery in a DELETE: a MERGE deletes the rows whose key comes in #}
{% set incomingTable = tableDomain + '.SL_INCOMING_' + tableName %}
DROP TABLE IF EXISTS {{ incomingTable }};
CREATE TABLE {{ incomingTable }} USING {{ tableFormat }} AS {{ selectStatement }};

MERGE INTO {{ tableFullName }} AS SL_EXISTING
USING (SELECT DISTINCT {{ strategyKeyCsv }} FROM {{ incomingTable }}) AS SL_INCOMING
ON {{ renderStrategyKeyJoinCondition('SL_EXISTING', 'SL_INCOMING', strategyKey) }}
WHEN MATCHED THEN DELETE;

INSERT INTO {{ tableFullName }} ({{ tableColumnsCsv }}) SELECT {{ tableColumnsCsv }}
FROM {{ incomingTable }};

DROP TABLE IF EXISTS {{ incomingTable }};
